# Set your domain and deployment bearer token before starting.
PREVIEW_DOMAIN=preview.example.com
PREVIEW_SERVER_TOKEN=
PREVIEW_GITHUB_TOKEN=
PREVIEW_MANAGEMENT_LISTEN=127.0.0.1:8080
PREVIEW_LISTEN=127.0.0.1:8081
PREVIEW_SERVER_WORKSPACE=/srv/preview-server
PREVIEW_STATE_ROOT=/var/lib/preview-server
PREVIEW_ARCHIVE_AFTER_IDLE=168h
PREVIEW_DELETE_AFTER_ARCHIVE=168h
PREVIEW_DASHBOARD_ORIGIN=
PREVIEW_DASHBOARD_ISSUER=
PREVIEW_DASHBOARD_CLIENT_ID=
PREVIEW_DASHBOARD_VIEW_GROUP=
PREVIEW_DASHBOARD_OPERATE_GROUP=
PREVIEW_MCP_ISSUER=
PREVIEW_MCP_RESOURCE=
PREVIEW_MCP_JWKS_URI=

# Source Compose bind mount on the Docker host
PREVIEW_PROJECTS_FILE=./projects.json
